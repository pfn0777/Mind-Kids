# BotFather -> /newbot -> token. Never commit the filled-in .env.
BOT_TOKEN=

# The deployed Mini App URL. Must be https:// — Telegram rejects anything else.
WEBAPP_URL=https://your-app.vercel.app

# Telegram user id allowed to run /stats. Get it by messaging @userinfobot.
ADMIN_ID=8264870741

# The photo sent with every /start. Relative paths resolve against bot/. The
# bot refuses to start if the file is missing.
WELCOME_PHOTO_PATH=media/welcome.png

# SQLite file for the anonymous user_id/first_seen/last_seen table. Relative
# paths resolve against bot/; the parent directory is created automatically.
DB_PATH=data/users.db

# Python logging level (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
